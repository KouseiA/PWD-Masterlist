{
  "name": "pwd-masterlist-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"node server.cjs\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.cjs",
    "dist": "node scripts/package.mjs",
    "dist:builder": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@tabler/icons-react": "^3.41.1",
    "animejs": "^4.3.6",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.363.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.3",
    "tailwind-merge": "^2.2.2",
    "tesseract.js": "^5.0.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/packager": "^19.1.0",
    "@electron/rebuild": "^4.0.3",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^10.1.0",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "vite": "^5.2.2",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "ph.gov.meycauayan.pwd-masterlist",
    "productName": "PWD Masterlist System",
    "copyright": "Copyright © 2026 Meycauayan City PWD Office",
    "icon": "public/icon.png",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.cjs",
      "node_modules/**/*",
      "package.json",
      "!node_modules/.cache/**/*",
      "!node_modules/**/{test,tests,__tests__,spec,docs,example,examples,coverage}/**/*",
      "!node_modules/**/*.{md,ts,map}"
    ],
    "extraResources": [
      {
        "from": "server.cjs",
        "to": "server.cjs"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PWD Masterlist",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
